{
  "name": "cnb-electrical-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Evidence-driven electrical CAD lab prototype",
  "scripts": {
    "demo": "python examples/run_core_demo.py",
    "cad:test": "node scripts/test_cad_export.cjs",
    "cad:evidence": "node scripts/generate_cad_evidence.cjs",
    "api:test": "node scripts/test_web_api.cjs",
    "r2:test": "py -3.10 -m pytest tests/test_r2_benchmark.py && node scripts/test_web_api.cjs",
    "ui:test": "node scripts/test_web_ui_behaviors.cjs",
    "web": "node apps/web/server.js 4173",
    "dev:web": "node apps/engineering-web/node_modules/vite/bin/vite.js --config apps/engineering-web/vite.config.ts --host 127.0.0.1 --port 4200",
    "dev:api": "node services/engineering-api/server.js",
    "build:web": "node apps/engineering-web/node_modules/vite/bin/vite.js --config apps/engineering-web/vite.config.ts build",
    "test:r5": "node scripts/test_r5_unified_workbench.cjs"
  }
}
